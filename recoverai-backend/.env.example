# Recipient defaults for local demos. Keep personal contact details only in .env,
# your shell environment, or a secret manager; never commit them.
RECOVERAI_DEMO_EMAIL=
RECOVERAI_DEMO_WHATSAPP_NUMBER=+<country-code><number>

# Gmail SMTP: enable 2-Step Verification, create a Google App Password, then set:
RECOVERAI_EMAIL_ENABLED=false
RECOVERAI_EMAIL_FROM=your-sending-address@gmail.com
SMTP_USERNAME=your-sending-address@gmail.com
SMTP_APP_PASSWORD=your-google-app-password

# Twilio WhatsApp: configure the WhatsApp Sandbox (demo) or an approved sender.
RECOVERAI_WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=+<country-code><number>

# Razorpay Test Mode webhook verification
RECOVERAI_PAYMENT_PROCESSING_MODE=RAZORPAY_TEST
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
